# Konfigurasi Server
PORT=3000
NODE_ENV=production
APP_NAME=Warung Pulsa
DOMAIN_NAME=yourdomain.com

# Admin
ADMIN_EMAIL=admin@yourdomain.com
BACKUP_PASSWORD=YourStrongPasswordHere

# Google OAuth Sign-In (Client ID)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# KMSP PPOB / Pulsa API
KMSP_API_KEY=your-kmsp-api-key

# AutoGoPay (ShopeePay & GoPay QRIS)
AUTOGOPAY_API_KEY=your-autogopay-key
SHOPEEPAY_QRIS_STATIC=your-shopeepay-qris-string
GOPAY_QRIS_STATIC=your-gopay-qris-string

# TriPay Payment Gateway
TRIPAY_MERCHANT_CODE=T00000
TRIPAY_API_KEY=your-tripay-api-key
TRIPAY_PRIVATE_KEY=your-tripay-private-key

# Violet Payment Gateway
VIOLET_API_KEY=your-violet-api-key
VIOLET_SECRET_KEY=your-violet-secret-key

# Telegram Bot Notification
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHANNEL_ID=@yourchannel
TELEGRAM_ADMIN_ID=123456789
TELEGRAM_GROUP_THREAD_ID=

# Google AI (Gemini) & DeepSeek
GEMINI_API_KEY=your-gemini-key
DEEPSEEK_API_KEY=your-deepseek-key

# Email Notification via Google Apps Script (GAS)
GAS_WEB_APP_URL=https://script.google.com/macros/s/xxx/exec
GAS_SECRET_TOKEN=your-gas-token

# Cendrawasih & VPS Sync API
CENDRAWASIH_API_KEY=
VPS_API_KEY=
VPS_IP=

# Cloudflare DNS API (Opsional)
CF_EMAIL=
CF_GLOBAL_KEY=
CF_API_TOKEN=
CF_ZONE_ID=
